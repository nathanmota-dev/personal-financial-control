# Execução fora do Docker: descomente e preencha as duas variáveis do Turso.
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
#
# Execução via Docker Compose: esta URL é injetada automaticamente no container.
# DATABASE_URL="file:/app/.local/personal-finance.db"
DEMO_MODE="false"
DATA_ENCRYPTION_KEY=""
# Token opcional da brapi. Obtenha uma chave em https://brapi.dev/dashboard.
# Sem ele, cotações automáticas ficam desabilitadas.
BRAPI_API_TOKEN=""
# Intervalo mínimo, em minutos, entre atualizações automáticas do mesmo ticker.
INVESTMENT_QUOTE_MIN_INTERVAL_MINUTES="30"
BROWSER_BIN="google-chrome"
# Crie um projeto e app Web em https://console.firebase.google.com/
# Configurações do projeto > Geral > Seus apps
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="SEU_PROJETO.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Preserve os escapes \n do campo private_key do JSON.
FIREBASE_PRIVATE_KEY=""
# Authentication > Sign-in method: habilite Google.
# Settings > Authorized domains: localhost, 127.0.0.1 e domínio de produção.
# Callback: https://SEU_PROJETO.firebaseapp.com/__/auth/handler
# Use porta 3000 para npm run dev; produção remota exige HTTPS.
APP_URL="http://127.0.0.1:3007"
