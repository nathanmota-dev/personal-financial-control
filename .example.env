# Execução fora do Docker: descomente e preencha as duas variáveis do Turso.
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
#
# Execução via Docker Compose: esta URL é injetada automaticamente no container.
# DATABASE_URL="file:/app/.local/personal-finance.db"
DEMO_MODE="false"
DATA_ENCRYPTION_KEY=""
# Token opcional da brapi. Obtenha uma chave em https://brapi.dev/dashboard.
# Sem ele, cotações automáticas ficam desabilitadas.
BRAPI_API_TOKEN=""
# Intervalo mínimo, em minutos, entre atualizações automáticas do mesmo ticker.
INVESTMENT_QUOTE_MIN_INTERVAL_MINUTES="30"
BROWSER_BIN="google-chrome"
# Token local do servidor MCP (mínimo de 32 caracteres). Sem ele, /api/mcp fica desabilitado.
PFC_MCP_TOKEN=""
