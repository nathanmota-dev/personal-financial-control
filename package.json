{
  "name": "personal-financial-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "auth:check": "tsx scripts/check-auth.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:backend": "eslint app/api app/actions lib proxy.ts --max-warnings=0",
    "lint:frontend": "eslint app components hooks lib/auth/client.ts lib/auth/login-errors.ts --ignore-pattern 'app/api/**' --ignore-pattern 'app/actions/**' --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run --config vitest.ci.config.ts --project backend",
    "test:frontend": "vitest run --config vitest.ci.config.ts --project frontend",
    "test:e2e": "playwright test",
    "test:coverage:ci": "vitest run --coverage",
    "benchmark": "vitest bench --run --config vitest.benchmark.config.ts",
    "benchmark:ci": "npm run benchmark -- --outputJson=reports/benchmarks/app.json",
    "quality:check": "node scripts/run-checks.js --root . --workflow quality",
    "quality:performance": "node scripts/run-checks.js --root . --workflow performance",
    "quality:backend": "node scripts/run-checks.js --root . --workflow backend",
    "quality:frontend": "node scripts/run-checks.js --root . --workflow frontend",
    "quality:e2e": "node scripts/run-checks.js --root . --workflow e2e",
    "quality:test": "npm test --prefix scripts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "import:itau-card": "tsx scripts/import-itau-card.ts",
    "db:bundle-migrator": "esbuild scripts/migrate.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/migrate.mjs",
    "test:coverage:target": "npm run test:coverage:ci && tsx tests/coverage/check-target.ts",
    "test:e2e:inspect": "tsx tests/e2e/helpers/inspect.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@libsql/client": "^0.17.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@zach.codes/react-calendar": "^0.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
